# PostgreSQL connection (Supabase: Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# CollegeFootballData (same key as the app)
CFB_API_KEY=

# NFL seasons to ingest (comma-separated)
NFL_SEASONS=2021,2022,2023,2024

# College seasons to ingest
CFB_SEASONS=2022,2023,2024

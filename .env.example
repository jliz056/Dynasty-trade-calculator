# Free API key for college stats on the Devy tab.
# Register at https://collegefootballdata.com/key (free, sent by email),
# then copy this file to .env and paste your key below.
VITE_CFB_API_KEY=

# Data pipeline (PostgreSQL / Supabase) — see data/README.md
DATABASE_URL=

# Supabase read access for the frontend (ML Lab projections + comparables).
# Project Settings -> API. The publishable/anon key is safe to ship to the
# browser; the tables are protected by read-only Row Level Security.
VITE_SUPABASE_URL=https://immwvhescrlhmfybwsjb.supabase.co
VITE_SUPABASE_ANON_KEY=

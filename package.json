{
  "name": "dynastytradecalculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy:firestore": "firebase deploy --only firestore:rules",
    "data:init": "python data/scripts/init_db.py",
    "data:ingest": "python data/ingest/run_all.py",
    "data:pipeline": "python data/scripts/run_pipeline.py",
    "data:values": "python data/models/baseline_values.py",
    "data:market": "python data/ingest/fantasycalc_values.py",
    "data:analog": "python data/models/analog_projection.py",
    "data:devy:train": "python data/models/devy_model.py train",
    "data:devy:predict": "python data/models/devy_model.py predict"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.13",
    "@mui/material": "^5.15.13",
    "@supabase/supabase-js": "^2.108.2",
    "firebase": "^10.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vercel/node": "^5.8.17",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
